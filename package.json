{
  "name": "legendary",
  "version": "2.0.0",
  "description": "Game server for Legion — Đường lên đỉnh Olympia style quiz show",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "author": "jang",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.14",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  },
  "pkg": {
    "assets": ["Legion/**/*", "match_data/*"],
    "targets": ["node20-win-x64"],
    "outputPath": "dist-pkg"
  }
}
